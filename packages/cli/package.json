{
  "name": "@life-optimizer/cli",
  "version": "0.1.0",
  "description": "Command-line interface for Life Optimizer",
  "type": "module",
  "bin": {
    "life-optimizer": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/bin.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node dist/bin.js --version"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.0",
    "typescript": "^7.0.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@life-optimizer/agent": "workspace:*",
    "@life-optimizer/ai": "workspace:*",
    "@life-optimizer/core": "workspace:*",
    "@life-optimizer/db": "workspace:*",
    "@life-optimizer/observability": "workspace:*",
    "@life-optimizer/patron": "workspace:*",
    "@life-optimizer/storage": "workspace:*",
    "dotenv": "^18.0.9",
    "zod": "^4.6.7"
  }
}
