{
  "name": "@life-optimizer/events",
  "version": "0.1.0",
  "description": "Transport-neutral durable event contracts and local broker for Life Optimizer",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./aws": {
      "types": "./dist/aws.js",
      "default": "./dist/aws.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.997.0",
    "@aws-sdk/client-sqs": "^3.997.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.0",
    "vitest": "^5.1.1"
  }
}
