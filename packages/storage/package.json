{
  "name": "@life-optimizer/storage",
  "version": "0.1.0",
  "description": "Object-storage contracts and an AWS S3 adapter for Life Optimizer",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./aws": {
      "types": "./dist/aws.d.ts",
      "default": "./dist/aws.js"
    },
    "./local": {
      "types": "./dist/local.d.ts",
      "default": "./dist/local.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.997.0",
    "@aws-sdk/lib-storage": "^3.997.0",
    "@aws-sdk/s3-request-presigner": "^3.997.0",
    "@life-optimizer/core": "workspace:*",
    "@life-optimizer/events": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.0",
    "vitest": "^5.1.1"
  }
}
