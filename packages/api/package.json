{
  "name": "@life-optimizer/api",
  "version": "0.1.0",
  "description": "Fastify HTTP, WebSocket, SSE, SOAP and OpenAPI adapter for Life Optimizer",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "predev": "pnpm --filter \"@life-optimizer/api...\" --filter \"!@life-optimizer/api\" -r --workspace-concurrency=1 run build",
    "dev": "tsx src/bin.ts",
    "start": "node dist/bin.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@life-optimizer/auth": "workspace:*",
    "@life-optimizer/core": "workspace:*",
    "@life-optimizer/cms": "workspace:*",
    "@life-optimizer/db": "workspace:*",
    "@life-optimizer/email": "workspace:*",
    "@life-optimizer/financial": "workspace:*",
    "@life-optimizer/feature-flags": "workspace:*",
    "@life-optimizer/notifications": "workspace:*",
    "@life-optimizer/patron": "workspace:*",
    "@life-optimizer/storage": "workspace:*",
    "@life-optimizer/observability": "workspace:*",
    "@life-optimizer/sms": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/websocket": "^11.2.0",
    "@types/nodemailer": "^8.0.2",
    "dotenv": "^18.0.9",
    "fast-xml-parser": "^5.3.4",
    "fastify": "^5.8.2",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.0",
    "vitest": "^5.1.1"
  }
}
